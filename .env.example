# 知识库工作台 运行配置示例（复制为 .env 后按需修改；切勿提交 .env）
# 所有变量均为可选，不使用 .env 也能直接 `node server/src/index.js` 本地运行。

# 监听地址与端口（云上部署请设为 0.0.0.0）
KB_HOST=127.0.0.1
KB_PORT=8787

# 数据目录（绝对路径或相对仓库根）；可整体拷贝实现迁移
KB_DATA_DIR=./data

# 接口鉴权：设置后所有 /api/* 需 Authorization: Bearer <值>
# KB_API_TOKEN=change-me-to-a-strong-token

# 凭证加密主密钥：建议云上设为强随机值（32+ 字符）。
# 不设置时将在 KB_DATA_DIR 下生成随机密钥文件 .master-key。
# KB_MASTER_KEY=

# 定时同步（分钟），0 = 仅手动；也可在每个数据源单独设置
KB_SYNC_INTERVAL_MINUTES=120

# 启动后是否对启用中的数据源各做一次同步
KB_SYNC_ON_BOOT=false

# 单源单次同步最多拉取条目数（防爆量）
KB_MAX_DOCS_PER_SOURCE=5000

# 外部 HTTP 代理（企业内网 / 大陆访问外网常用）
# KB_HTTP_PROXY=http://proxy.internal:8080
# NO_PROXY=169.254.169.254,localhost,127.0.0.1
