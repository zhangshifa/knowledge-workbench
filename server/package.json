{
  "name": "knowledge-workbench-server",
  "version": "0.1.0",
  "description": "统一知识库工作台服务端：零依赖、多平台接入、MCP 双向、三端可用、本地/云上部署",
  "type": "module",
  "private": true,
  "bin": {
    "kb-server": "src/index.js",
    "kb-mcp": "scripts/mcp-stdio.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "mcp": "node scripts/mcp-stdio.js",
    "dev": "node --watch src/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
